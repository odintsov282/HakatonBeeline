# Скопировать в .env (сам .env в .gitignore, в репозиторий не попадает).
# После правки .env — обязательно перезапустить `npm run dev` (Vite подхватывает .env только при старте).

# Базовый адрес бэкенда. Все запросы фронта идут на VITE_API_URL + путь эндпоинта,
# например VITE_API_URL=http://localhost:8000/api -> запрос логина уйдёт на
# http://localhost:8000/api/auth (см. src/api/http.js и src/api/auth.js).
VITE_API_URL=http://localhost:8000/api
